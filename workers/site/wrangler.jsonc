{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hekswerk-site",
  "compatibility_date": "2026-08-12",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "www.hekswerk.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "../../build",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
    },
  },
}
